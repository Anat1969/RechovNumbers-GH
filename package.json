{
  "name": "rechov-numbers",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "snapshot": "node scripts/fetch-snapshot.mjs",
    "build": "node scripts/fetch-snapshot.mjs && tsc -b && vite build",
    "build:github": "tsc -b && vite build --base=./ --outDir app --emptyOutDir",
    "preview": "vite preview --port 4199 --strictPort",
    "test": "node tests/e2e.cjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
